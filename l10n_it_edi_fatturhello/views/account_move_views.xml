<odoo>
    <record model="ir.ui.view" id="view_account_invoice_filter">
        <field name="name">Add fatturhello fields to Invoice search view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <search position="inside">
                <field name="fatturhello_protocol" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="view_fatturapa_out_attachment_form">
        <field
            name="name"
        >Add fatturhello fields to Electronic Invoice form view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_it_edi.account_invoice_form_l10n_it" />
        <field name="arch" type="xml">
            <page name="electronic_invoicing" position="inside">
                <group
                    name="fatturhello"
                    string="Fatturhello"
                    invisible="not fatturhello_is_used"
                >
                    <field name="fatturhello_protocol" string="Protocol" />
                    <field
                        groups="base.group_no_one"
                        name="fatturhello_last_processed_status_datetime"
                        string="Last processed status"
                    />
                </group>
            </page>
        </field>
    </record>
</odoo>
