<odoo>
    <record id="account_tax_form_l10n_it_tu_iva" model="ir.ui.view">
        <field name="name">account.tax.form.l10n.it.tu.iva</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="l10n_it.account_tax_form_l10n_it" />
        <field name="arch" type="xml">
            <!-- The reference of the Testo Unico IVA configured tax by tax,
                 for the taxes whose automatic wording does not fit. A tax
                 group has no reference of its own: the child taxes are the
                 ones the e-invoice uses. -->
            <xpath expr="//field[@name='l10n_it_law_reference']" position="after">
                <field
                    name="l10n_it_tu_iva_law_reference"
                    invisible="amount_type == 'group'"
                />
            </xpath>
        </field>
    </record>
</odoo>
