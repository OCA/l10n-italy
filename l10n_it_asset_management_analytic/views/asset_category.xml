<odoo>
    <record id="asset_category_form_view" model="ir.ui.view">
        <field name="name">Add analytic distribution to asset category form</field>
        <field name="model">asset.category</field>
        <field
            name="inherit_id"
            ref="l10n_it_asset_management.asset_category_form_view"
        />
        <field name="arch" type="xml">
            <field name="loss_account_id" position="after">
                <field
                    name="analytic_distribution"
                    widget="analytic_distribution"
                    groups="analytic.group_analytic_accounting"
                />
            </field>
        </field>
    </record>
</odoo>
