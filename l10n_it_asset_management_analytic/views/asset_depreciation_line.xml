<odoo>
    <record id="asset_dep_line_tree_view" model="ir.ui.view">
        <field name="name">Add analytic distribution to depreciation line list</field>
        <field name="model">asset.depreciation.line</field>
        <field
            name="inherit_id"
            ref="l10n_it_asset_management.asset_dep_line_tree_view"
        />
        <field name="arch" type="xml">
            <field name="move_id" position="before">
                <field
                    name="analytic_distribution"
                    widget="analytic_distribution"
                    groups="analytic.group_analytic_accounting"
                    optional="hide"
                />
            </field>
        </field>
    </record>

    <record id="asset_dep_line_form_view" model="ir.ui.view">
        <field name="name">Add analytic distribution to depreciation line form</field>
        <field name="model">asset.depreciation.line</field>
        <field
            name="inherit_id"
            ref="l10n_it_asset_management.asset_dep_line_form_view"
        />
        <field name="arch" type="xml">
            <field name="move_id" position="before">
                <field
                    name="analytic_distribution"
                    widget="analytic_distribution"
                    groups="analytic.group_analytic_accounting"
                />
            </field>
        </field>
    </record>
</odoo>
