<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_term_form_fatturapa" model="ir.ui.view">
        <field name="name">account.payment.term.form.fatturapa</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="fatturapa_retrieve_due_dates" 
                       help="If set, payment terms will be retrieved from the XML when creating invoices from electronic invoices."/>
            </xpath>
        </field>
    </record>
</odoo>