<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_company_form_l10n_it_sender_view" model="ir.ui.view">
        <field name="name">res.company.form.l10n.it.sender.view</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_it_edi.res_company_form_l10n_it" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_it_tax_system']" position="after">
                <field
                    name="l10n_edi_it_sender_partner"
                    invisible="country_code != 'IT'"
                />
            </xpath>
        </field>
    </record>
</odoo>
