<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_invoice_form_intermediary" model="ir.ui.view">
        <field name="name">account.invoice.intermediary</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_it_edi.account_invoice_form_l10n_it" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_it_edi_transaction']" position="after">
                <field name="l10n_it_edi_intermediary_id" readonly="1" />
            </xpath>
        </field>
    </record>
</odoo>
