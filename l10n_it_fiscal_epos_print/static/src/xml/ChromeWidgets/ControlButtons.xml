<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="l10n_it_fiscal_epos_print.ControlButtons"
        t-inherit="point_of_sale.ControlButtons"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//t[@t-if='props.showRemainingButtons']/div/OrderlineNoteButton"
            position="after"
        >
            <t t-if="pos.get_order() and pos.get_order().has_refund">
                <SetRefundInfoButton />
            </t>
            <SetLotteryCodeButton />
        </xpath>
    </t>
</templates>
