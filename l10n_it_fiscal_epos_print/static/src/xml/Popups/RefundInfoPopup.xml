<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="RefundInfoPopup">
        <Dialog title="props.title" size="'md'">
            <div class='client-detail'>
                <div class='label'>Closing Seq.</div>
                <input
                    id="refund_report"
                    class="detail refund_report"
                    type='text'
                    t-att-value="props.refund_report || ''"
                    t-ref="inputRefundReport"
                    placeholder="Max 4 numbers"
                />
            </div>
            <div class='client-detail'>
                <div class='label'>Receipt Num.</div>
                <input
                    id="refund_doc_num"
                    class="detail refund_doc_num"
                    type='text'
                    t-att-value="props.refund_doc_num || ''"
                    t-ref="inputRefundDocNum"
                    placeholder="Max 4 numbers"
                />
            </div>
            <div class='client-detail'>
                <div class='label'>Receipt Date</div>
                <input
                    id="refund_date"
                    class="detail refund_date"
                    type='text'
                    pattern="\d{4}-\d{2}-\d{2}"
                    t-att-value="props.refund_date || ''"
                    t-ref="inputRefundDate"
                    placeholder="YYYY-MM-DD"
                />
            </div>
            <div class='client-detail'>
                <div class='label'>RT Serial</div>
                <input
                    id="refund_cash_fiscal_serial"
                    class="detail refund_cash_fiscal_serial"
                    type='text'
                    t-att-value="props.refund_cash_fiscal_serial || ''"
                    t-ref="inputRefundCashFiscalSerial"
                    placeholder="RT Serial"
                />
            </div>
            <div class='client-detail'>
                <div class='label'>Full Refund</div>
                <input
                    id="refund_full_refund"
                    class="detail refund_full_refund"
                    type='checkbox'
                    t-att-checked="props.refund_full_refund || ''"
                    t-ref="inputRefundFullRefund"
                />
            </div>
            <div
                id="error-message-dialog"
                style="color: red; font-weight: bold; font-size: 18px; font-style: italic; margin-top: 10px;"
                t-att-class="{'d-none': !state.showError}"
            >
                Some fields are empty.
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="clickConfirmRefund">
                    <t t-esc="props.confirmText" />
                </button>
                <button class="btn btn-secondary" t-on-click="props.close">
                    <t t-esc="props.cancelText" />
                </button>
            </t>
        </Dialog>
    </t>

</templates>
