<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="SetRefundInfoButton">
        <button
            id="refund_info_button"
            class='btn btn-secondary btn-lg py-5'
            t-att-style="'background-color: ' + buttonColor"
            t-on-click="() => this.onClickRefund()"
        >
            <i class='fa fa-pencil-square-o me-1' />
            Refund Data
        </button>
    </t>

</templates>
