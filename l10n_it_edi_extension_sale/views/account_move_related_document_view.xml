<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_move_related_document_view_form" model="ir.ui.view">
        <field
            name="name"
        >Add sale fields to account.move.related_document form view</field>
        <field name="model">account.move.related_document</field>
        <field
            name="inherit_id"
            ref="l10n_it_edi_related_document.account_move_related_document_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_id']" position="after">
                <field name="sale_order_id" />
                <field name="sale_order_line_id" />
            </xpath>
        </field>
    </record>
</odoo>
