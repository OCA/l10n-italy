<odoo>
    <record id="trial_balance_wizard_view_form" model="ir.ui.view">
        <field name="model">trial.balance.report.wizard</field>
        <field name="inherit_id" ref="account_financial_report.trial_balance_wizard" />
        <field name="arch" type="xml">
            <field name="target_move" position="after">
                <field name="ignore_closing_move" />
            </field>
        </field>
    </record>

    <record id="financial_statements_wizard_view_form" model="ir.ui.view">
        <field name="model">trial.balance.report.wizard</field>
        <field
            name="inherit_id"
            ref="l10n_it_financial_statements_report.wizard_report_financial_statements_report"
        />
        <field name="arch" type="xml">
            <field name="target_move" position="after">
                <field name="ignore_closing_move" />
            </field>
        </field>
    </record>
</odoo>
