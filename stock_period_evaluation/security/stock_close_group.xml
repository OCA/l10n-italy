<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">
    <record id="module_category_stock_period_evaluation" model="ir.module.category">
        <field name="name">Stock Period Evaluation</field>
    </record>

    <record id="group_stock_period_evaluation_user_readonly" model="res.groups">
        <field name="name">User (Read Only)</field>
        <field
            name="category_id"
            ref="stock_period_evaluation.module_category_stock_period_evaluation"
        />
    </record>

    <record id="group_stock_period_evaluation_manager" model="res.groups">
        <field name="name">Manager</field>
        <field
            name="category_id"
            ref="stock_period_evaluation.module_category_stock_period_evaluation"
        />
        <field
            name="implied_ids"
            eval="[(4, ref('stock_period_evaluation.group_stock_period_evaluation_user_readonly'))]"
        />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>

    <record id="stock_period_evaluation_comp_rule" model="ir.rule">
        <field name="name">Stock Period Evaluation Company Rule</field>
        <field name="model_id" ref="stock_period_evaluation.model_stock_close_period" />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

    <record id="stock_period_evaluation_line_comp_rule" model="ir.rule">
        <field name="name">Stock Period Evaluation Line Company Rule</field>
        <field
            name="model_id"
            ref="stock_period_evaluation.model_stock_close_period_line"
        />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
