<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_74ter_inherit" model="ir.ui.view">
        <field name="name">view_move_form_74ter_inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!--
                The v16 anchor //field[@name='invoice_vendor_bill_id'] no longer
                exists on the v18 invoice form. We anchor after the whole
                due-date block (div[@name='due_date']) so the fields land as
                direct children of header_right_group and render as normal
                labeled rows; anchoring on invoice_payment_term_id would inject
                them *inside* that div's flex row, unlabeled and cramped.
                attrs/states were removed in Odoo 17: use inline expressions.
            -->
            <xpath expr="//div[@name='due_date']" position="after">
                <field name="is_partner_74ter_agent" invisible="1" />
                <field
                    name="agent_74ter_id"
                    domain="[('is_74ter_agent', '=', True)]"
                    invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt') or is_partner_74ter_agent"
                />
                <field
                    name="to_be_paid_by_agent_74ter"
                    invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt') or not agent_74ter_id"
                />
            </xpath>
        </field>
    </record>

    <!--
        "Send to SDI" for 74-ter autofatture.

        l10n_it_edi_extension hides the core button when the document type is
        TD01/TD04/TD24 (on an ordinary purchase document those are e-invoices
        RECEIVED from the supplier). A 74-ter self-billing document is issued
        by the company itself as TD01 (bill) or TD04 (credit note), so a
        dedicated button is added with the core visibility conditions plus the
        74-ter one, instead of fighting over the core button's `invisible`
        expression with other modules (e.g. l10n_it_edi_td29). Keep in sync
        with account.move._l10n_it_edi_ext_is_document_type_to_send.
    -->
    <record id="account_invoice_form_l10n_it_74ter_send" model="ir.ui.view">
        <field name="name">account.move.form.l10n.it.74ter.send</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_it_edi.account_invoice_form_l10n_it" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_l10n_it_edi_send']" position="after">
                <field name="l10n_it_edi_is_74ter_self_billing" invisible="1" />
                <button
                    name="action_l10n_it_edi_send"
                    type="object"
                    string="Send to SDI"
                    invisible="not l10n_it_edi_is_74ter_self_billing or state != 'posted' or is_move_sent or country_code != 'IT' or l10n_it_edi_state in ('rejected', 'rejected_by_pa_partner')"
                />
            </xpath>
        </field>
    </record>
</odoo>
