msgstr "Ali intere congelate di anatre domestiche"

#. module: l10n_it_intrastat
#: model:report.intrastat.code,description:l10n_it_intrastat.intrastat_category_2014_02075531
msgid "Frozen whole wings of domestic geese"
msgstr "Ali intere congelate di oche domestiche"

#. module: l10n_it_intrastat
#: model:report.intrastat.code,description:l10n_it_intrastat.intrastat_category_2014_02071430
msgid ""
