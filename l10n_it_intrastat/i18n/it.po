msgstr "Selle e quarti posteriori di bovini, non disossati, congelati"

#. module: l10n_it_intrastat
#: model:report.intrastat.code,description:l10n_it_intrastat.intrastat_category_2014_03036930
msgid "Frozen whiting \"Merlangius merlangus\""
msgstr "Merlani congelati (Merlangius merlangus)"

#. module: l10n_it_intrastat
#: model:report.intrastat.code,description:l10n_it_intrastat.intrastat_category_2014_02074531
