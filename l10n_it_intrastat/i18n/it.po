#. module: l10n_it_intrastat
#: model:report.intrastat.code,description:l10n_it_intrastat.intrastat_category_2014_03034242
msgid ""
"Frozen yellowfin tunas \"Thunnus albacares\" for industrial manufacture of "
"products of 1604, weighing > 10 kg each (excl. whole)"
msgstr ""
"Tonni gialli o albacora, di peso > 10 kg per pezzo, congelati e destinati "
