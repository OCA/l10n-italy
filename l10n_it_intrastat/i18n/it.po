#. module: l10n_it_intrastat
#: model:report.intrastat.code,description:l10n_it_intrastat.intrastat_category_2014_72271000
msgid ""
"Bars and rods of high-speed steel, hot-rolled, in irregularly wound coils"
msgstr "Vergella o bordione di acciai rapidi, in matasse (Ceca)"

#. module: l10n_it_intrastat
#: model:report.intrastat.code,description:l10n_it_intrastat.intrastat_category_2014_72281090
msgid ""
