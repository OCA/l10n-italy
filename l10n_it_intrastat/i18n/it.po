"apparecchi per gassare le bevande"

#. module: l10n_it_intrastat
#: model:report.intrastat.code,description:l10n_it_intrastat.intrastat_category_2014_84393000
msgid "Machinery for finishing paper or paperboard (excl. calenders)"
msgstr ""
"Macchine ed apparecchi per la finitura della carta o del cartone (escl. "
