#. module: l10n_it_intrastat
#: model:report.intrastat.code,description:l10n_it_intrastat.intrastat_category_2014_03034218
msgid ""
"Frozen yellowfin tunas \"Thunnus albacares\" for industrial manufacture of "
"products of 1604, whole, weighing <= 10 kg each"
msgstr ""
"Tonni albacora, congelati, interi, di peso > 10 kg, per la fabbricazione di "
"preparazioni e conserve di pesce"

#. module: l10n_it_intrastat
#: model:report.intrastat.code,description:l10n_it_intrastat.intrastat_category_2014_03034212
msgid ""
"Frozen yellowfin tunas \"Thunnus albacares\" for industrial manufacture of "
"products of 1604, whole, weighing > 10 kg each"
msgstr ""
"Tonni albacora, congelati, interi, di peso > 10 kg, per la fabbricazione di "
"preparazioni e conserve di pesce"

#. module: l10n_it_intrastat
#: model:report.intrastat.code,description:l10n_it_intrastat.intrastat_category_2014_03031300
msgid ""
