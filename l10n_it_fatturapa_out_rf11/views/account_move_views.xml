<odoo>
    <record id="view_move_form_74ter_inherit" model="ir.ui.view">
        <field name="name">view_move_form_74ter_inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_vendor_bill_id']" position="after">
                <field name="is_partner_74ter_agent" invisible="1"/>
                <field name="agent_74ter_id"
                    domain="[('is_74ter_agent', '=', True)]"
                    attrs="{'invisible': ['|', ('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt')), ('is_partner_74ter_agent', '=', True)]}"/>
                <field name="to_be_paid_by_agent_74ter"
                    attrs="{'invisible': ['|', ('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt')), ('agent_74ter_id', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
