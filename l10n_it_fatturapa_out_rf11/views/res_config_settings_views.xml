<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form_rf11" model="ir.ui.view">
            <field name="name">res_config_settings_view_form_rf11</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='use_invoice_terms']" position="after">
                    <div class="col-12 col-lg-6 o_setting_box" id="payments_74ter_journal_id">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Journal for agencies payments</span>
                            <div class="text-muted">
                                Journal where to register entries used to write off customer credit in favor of agency credit
                            </div>
                            <div class="text-muted">
                                <field name="payments_74ter_journal_id"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
