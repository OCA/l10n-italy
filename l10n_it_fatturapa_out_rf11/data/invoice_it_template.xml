<odoo>
    <template id="account_invoice_it_dati_trasmissione_74ter_se_inherit" inherit_id="l10n_it_fatturapa_out.account_invoice_it_FatturaPA_export">
        <xpath expr="//SoggettoEmittente" position="replace">
            <t t-set="og_partner" t-value="invoices[0].rc_purchase_invoice_id.rc_original_purchase_invoice_ids[0].partner_id"/>
            <t t-set="company_fiscal_position_code" t-value="company_id.fatturapa_fiscal_position_id.code"/>
            <t t-set="is_cc" t-value="og_partner and og_partner.is_74ter_agent and company_fiscal_position_code == 'RF11'" />
            <t t-if="is_cc">
                <SoggettoEmittente>CC</SoggettoEmittente>
            </t>
            <t t-if="company_id.fatturapa_sender_partner and not is_cc">
                <SoggettoEmittente>TZ</SoggettoEmittente>
            </t>
        </xpath>
    </template>
    <template id="account_invoice_it_fattura_elettronica_body_74ter_inherit" inherit_id="l10n_it_fatturapa_out.account_invoice_it_fattura_elettronica_body">
        <xpath expr="//ImportoTotaleDocumento" position="replace">
            <t t-set="og_partner" t-value="invoices[0].rc_purchase_invoice_id.rc_original_purchase_invoice_ids[0].partner_id"/>
            <t t-set="company_fiscal_position_code" t-value="company_id.fatturapa_fiscal_position_id.code"/>
            <t t-set="is_rf11" t-value="og_partner and og_partner.is_74ter_agent and company_fiscal_position_code == 'RF11'" />
            <t t-if="not is_rf11">
                <ImportoTotaleDocumento
                    t-out="format_numbers_two(get_importo_totale(record))"
                />
            </t>
        </xpath>
    </template>
</odoo>