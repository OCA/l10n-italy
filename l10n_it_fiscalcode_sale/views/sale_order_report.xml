<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_saleorder_document_fiscal_fields_ext"
        inherit_id="sale.report_saleorder_document"
    >
        <xpath expr="//p[@t-if='doc.partner_id.vat']" position="after">
            <p
                t-if="doc.partner_id.l10n_it_codice_fiscale and (not doc.partner_id.vat or (doc.partner_id.vat and doc.partner_id.vat[2:] != doc.partner_id.l10n_it_codice_fiscale))"
                class="mb-0"
            >
                <span>Fiscal code: </span>
                <span t-field="doc.partner_id.l10n_it_codice_fiscale" />
            </p>
        </xpath>
    </template>
</odoo>
