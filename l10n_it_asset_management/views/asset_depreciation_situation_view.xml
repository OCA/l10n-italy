<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_asset_depreciation_situation_list" model="ir.ui.view">
        <field name="name">asset.depreciation.situation.list</field>
        <field name="model">asset.depreciation</field>
        <field name="arch" type="xml">
            <list string="Situazione Cespiti">
                <field name="l10n_it_asset_id" string="Cespite" />
                <field name="type_id" string="Tipo Ammortamento" />
                <field
                    name="amount_depreciable_updated"
                    string="Importo Ammortizzabile"
                    sum="Totale Ammortizzabile"
                />
                <field
                    name="amount_depreciated"
                    string="Importo Ammortizzato"
                    sum="Totale Ammortizzato"
                />
                <field
                    name="amount_residual"
                    string="Residuo"
                    sum="Totale Residuo"
                />
                <field
                    name="last_depreciation_date"
                    string="Ultima Data Ammortamento"
                />
            </list>
        </field>
    </record>

    <record id="action_asset_depreciation_situation" model="ir.actions.act_window">
        <field name="name">Situazione Cespiti</field>
        <field name="res_model">asset.depreciation</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_asset_depreciation_situation_list" />
        <field name="context">{'group_by': 'l10n_it_asset_id.category_id'}</field>
    </record>

    <menuitem
        id="menu_asset_situation"
        name="Situazione Cespiti"
        parent="menu_asset_reports"
        action="action_asset_depreciation_situation"
        sequence="30"
    />
</odoo>
