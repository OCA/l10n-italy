<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_plafond_year_tree" model="ir.ui.view">
        <field name="name">l10n_it_edi_doi_extension.plafond.year.tree</field>
        <field name="model">l10n_it_edi_doi_extension.plafond.year</field>
        <field name="arch" type="xml">
            <list string="Annual Plafond">
                <field name="year_display" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="plafond_total" widget="monetary" />
                <field name="plafond_assigned" widget="monetary" optional="show" />
                <field name="plafond_used" widget="monetary" />
                <field
                    name="plafond_available"
                    widget="monetary"
                    decoration-danger="plafond_available &lt; 0"
                    decoration-warning="plafond_available &lt; plafond_total * 0.1"
                />
                <field name="usage_percentage" widget="progressbar" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_plafond_year_form" model="ir.ui.view">
        <field name="name">l10n_it_edi_doi_extension.plafond.year.form</field>
        <field name="model">l10n_it_edi_doi_extension.plafond.year</field>
        <field name="arch" type="xml">
            <form string="Annual Plafond">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_declarations"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                        >
                            <field
                                name="declaration_ids"
                                widget="statinfo"
                                string="Declarations"
                            />
                        </button>
                        <button
                            name="action_open_invoices"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o"
                        >
                            <field
                                name="invoice_count"
                                widget="statinfo"
                                string="Invoices"
                            />
                        </button>
                    </div>

                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />

                    <div
                        class="alert alert-danger"
                        role="alert"
                        invisible="plafond_available &gt;= 0"
                    >
                        <strong>WARNING:</strong> Plafond exceeded!
                        The used amount exceeds the total plafond.
                    </div>

                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="plafond_available &lt; 0 or usage_percentage &lt; 90"
                    >
                        <strong>Attention:</strong> Plafond almost exhausted
                        (<field name="usage_percentage" nolabel="1" />% used)
                    </div>

                    <group>
                        <group string="Identification">
                            <field name="year_display" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="currency_id" invisible="1" />
                            <field name="active" invisible="1" />
                        </group>
                        <group string="Amounts">
                            <field name="plafond_total" />
                            <field name="plafond_assigned" />
                            <field name="plafond_used" />
                            <field
                                name="plafond_available"
                                decoration-danger="plafond_available &lt; 0"
                            />
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="usage_percentage" widget="percentpie" />
                        </group>
                        <group>
                            <field name="note" placeholder="Internal notes..." />
                        </group>
                    </group>

                    <notebook>
                        <page string="Declarations of Intent" name="declarations">
                            <field name="declaration_ids" readonly="1">
                                <list>
                                    <field name="protocol_number_part1" />
                                    <field name="protocol_number_part2" />
                                    <field name="partner_id" />
                                    <field name="start_date" />
                                    <field name="end_date" />
                                    <field name="threshold" optional="show" />
                                    <field name="invoiced" />
                                    <field name="remaining" />
                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-success="state == 'active'"
                                        decoration-info="state == 'draft'"
                                        decoration-danger="state == 'revoked'"
                                        decoration-muted="state == 'terminated'"
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_plafond_year_search" model="ir.ui.view">
        <field name="name">l10n_it_edi_doi_extension.plafond.year.search</field>
        <field name="model">l10n_it_edi_doi_extension.plafond.year</field>
        <field name="arch" type="xml">
            <search string="Search Plafond">
                <field
                    name="year_display"
                    string="Year"
                    filter_domain="[('year', '=', int(self))]"
                />
                <field name="company_id" groups="base.group_multi_company" />

                <filter
                    string="Current Year"
                    name="current_year"
                    domain="[('year', '=', (context_today()).year)]"
                />
                <filter
                    string="Low Availability"
                    name="low_availability"
                    domain="[('usage_percentage', '&gt;=', 80)]"
                />

                <separator />
                <filter
                    string="Archived"
                    name="archived"
                    domain="[('active', '=', False)]"
                />

                <group expand="0" string="Group By">
                    <filter
                        string="Year"
                        name="group_year"
                        context="{'group_by': 'year_display'}"
                    />
                    <filter
                        string="Company"
                        name="group_company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_plafond_year" model="ir.actions.act_window">
        <field name="name">Annual Plafond</field>
        <field name="res_model">l10n_it_edi_doi_extension.plafond.year</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Annual Plafond
            </p>
            <p>
                Record the total plafond assigned by Agenzia delle Entrate for the year.
                This plafond will be used to track and control issued Declarations of Intent.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem
        id="menu_plafond_year"
        name="Annual Plafond"
        parent="account.menu_finance_entries"
        action="action_plafond_year"
        sequence="11"
    />
</odoo>
